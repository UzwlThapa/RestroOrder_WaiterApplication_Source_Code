<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="end"
        android:id="@+id/layout_no_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/view_room_item_layout_image_paddingTop"
            android:textStyle="bold"
            android:textColor="@color/orange"
            android:id="@+id/tv_show_costcenter_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:text="KOT"
            android:fontFamily="sans-serif-condensed"/>
        <TextView
            android:textSize="@dimen/view_room_item_layout_image_paddingTop"
            android:textStyle="bold"
            android:id="@+id/tv_show_costcenter_rs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:text="Rs."
            android:fontFamily="sans-serif-condensed"/>
        <TextView
            android:textSize="@dimen/view_room_item_layout_image_paddingTop"
            android:textStyle="bold"
            android:id="@+id/tv_show_costcenter_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:text="0"
            android:fontFamily="sans-serif-condensed"/>
        <TextView
            android:textSize="@dimen/view_room_item_layout_image_paddingTop"
            android:textStyle="bold"
            android:textColor="@color/orange"
            android:id="@+id/show_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:text="Disc"
            android:fontFamily="sans-serif-condensed"/>
        <TextView
            android:textSize="@dimen/view_room_item_layout_image_paddingTop"
            android:textStyle="bold"
            android:id="@+id/tv_show_costcenter_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:text="0%"
            android:fontFamily="sans-serif-condensed"/>
        <TextView
            android:textSize="@dimen/view_room_item_layout_image_paddingTop"
            android:textStyle="bold"
            android:id="@+id/show_equals"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:text="="
            android:fontFamily="sans-serif-condensed"/>
        <TextView
            android:textSize="@dimen/view_room_item_layout_image_paddingTop"
            android:textStyle="bold"
            android:layout_gravity="end"
            android:id="@+id/tv_show_totalmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:text="0"
            android:fontFamily="sans-serif-condensed"/>
    </LinearLayout>
</LinearLayout>
