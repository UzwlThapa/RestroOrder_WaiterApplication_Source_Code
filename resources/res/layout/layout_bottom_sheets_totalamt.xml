<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="top|right"
    android:orientation="vertical"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:behavior_peekHeight="@dimen/sheetpeekHeight"
    app:behavior_hideable="false"
    app:layout_behavior="android.support.design.widget.BottomSheetBehavior">
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/relativelayout_bottomsheetlayout"
        android:background="@color/orange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_opendrawer_bottomsheet"
            android:background="@drawable/ic_botttomsheet_expand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="10dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:layout_behavior="android.support.design.widget.BottomSheetBehavior"/>
        <TextView
            android:textSize="@dimen/menu_menu"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/tv_totalamt1_bottomsheet"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="Total Amount"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-condensed"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layout_totalamt_bottomsheets"
        android:background="@color/bottomsheetbackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp">
        <LinearLayout
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:layout_weight="1">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/menu_menu"
                    android:textStyle="bold"
                    android:textColor="@color/orange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:text="Sales Discount"
                    android:layout_alignParentLeft="true"
                    android:fontFamily="sans-serif-condensed"/>
                <TextView
                    android:textSize="@dimen/menu_menu"
                    android:textStyle="bold"
                    android:textColor="@color/orange"
                    android:id="@+id/tv_extraItemList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:text="Extra Items"
                    android:layout_centerHorizontal="true"
                    android:fontFamily="sans-serif-condensed"/>
                <Button
                    android:textSize="@dimen/activity_main_bt_send_textSize"
                    android:textColor="@color/black"
                    android:layout_gravity="end"
                    android:id="@+id/bt.pay"
                    android:background="@drawable/button_bg"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:text="Pay"
                    android:layout_alignParentRight="true"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif-condensed"/>
            </RelativeLayout>
            <View
                android:background="@color/lightgrey"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/noItems"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_main_bt_send_marginRight"
                    android:text="No Data"
                    android:layout_centerHorizontal="true"/>
                <ListView
                    android:id="@+id/lv_botomsheet_discount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/sv_extraItems"
                    android:background="@color/orange"
                    android:visibility="invisible"
                    android:layout_width="@dimen/activity_login_pin_width"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true">
                    <ScrollView
                        android:background="@color/white"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/activity_login_iv_copyright_paddingLeft">
                        <android.support.v7.widget.RecyclerView
                            android:id="@+id/rv_extraItems"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/activity_main_view_width"/>
                    </ScrollView>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:padding="@dimen/bg_logout_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/activity_main_view_width">
                        <TextView
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Total: "
                            android:layout_weight="1"/>
                        <TextView
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:id="@+id/tv_extraTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true">
                    <LinearLayout
                        android:gravity="end"
                        android:layout_gravity="end"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/spinner_txt_size"
                            android:textStyle="bold"
                            android:textColor="@color/seventytransparentblack"
                            android:layout_gravity="end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sub Amount :"
                            android:fontFamily="sans-serif-condensed"/>
                        <TextView
                            android:textSize="@dimen/spinner_txt_size"
                            android:textStyle="bold"
                            android:textColor="@color/seventytransparentblack"
                            android:id="@+id/tv_subamount_bottomsheet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="end"
                        android:layout_gravity="end"
                        android:orientation="horizontal"
                        android:id="@+id/layoutRoomCharge"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/spinner_txt_size"
                            android:textStyle="bold"
                            android:textColor="@color/seventytransparentblack"
                            android:layout_gravity="end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Room Charge :"
                            android:fontFamily="sans-serif-condensed"/>
                        <TextView
                            android:textSize="@dimen/spinner_txt_size"
                            android:textStyle="bold"
                            android:textColor="@color/seventytransparentblack"
                            android:id="@+id/tv_roomchargeamount_bottomsheet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="end"
                        android:layout_gravity="end"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/spinner_txt_size"
                            android:textStyle="bold"
                            android:textColor="@color/seventytransparentblack"
                            android:layout_gravity="end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Discounted Amount :"
                            android:fontFamily="sans-serif-condensed"/>
                        <TextView
                            android:textSize="@dimen/spinner_txt_size"
                            android:textStyle="bold"
                            android:textColor="@color/seventytransparentblack"
                            android:id="@+id/tv_totaldiscount_bottomsheet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="end"
                        android:layout_gravity="end"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/spinner_txt_size"
                            android:textStyle="bold"
                            android:textColor="@color/seventytransparentblack"
                            android:gravity="end"
                            android:layout_gravity="right"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Basic Amount :"
                            android:fontFamily="sans-serif-condensed"/>
                        <TextView
                            android:textSize="@dimen/spinner_txt_size"
                            android:textStyle="bold"
                            android:textColor="@color/seventytransparentblack"
                            android:id="@+id/tv_total_bottomsheet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="end"
                        android:layout_gravity="end"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/spinner_txt_size"
                            android:textStyle="bold"
                            android:textColor="@color/seventytransparentblack"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total With Extra :"
                            android:fontFamily="sans-serif-condensed"/>
                        <TextView
                            android:textSize="@dimen/spinner_txt_size"
                            android:textStyle="bold"
                            android:textColor="@color/seventytransparentblack"
                            android:id="@+id/tv_totalWithExtra"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="end"
                        android:layout_gravity="end"
                        android:orientation="horizontal"
                        android:id="@+id/layout_billing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <LinearLayout
                        android:gravity="end"
                        android:layout_gravity="end"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/spinner_txt_size"
                            android:textStyle="bold"
                            android:textColor="@color/seventytransparentblack"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Amount :"
                            android:fontFamily="sans-serif-condensed"/>
                        <TextView
                            android:textSize="@dimen/spinner_txt_size"
                            android:textStyle="bold"
                            android:textColor="@color/seventytransparentblack"
                            android:id="@+id/tv_total_taxable_bottomsheet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="end"
                        android:layout_gravity="end"
                        android:orientation="horizontal"
                        android:id="@+id/layoutAdvancePayment"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/spinner_txt_size"
                            android:textStyle="bold"
                            android:textColor="@color/seventytransparentblack"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Advance Payment :"
                            android:fontFamily="sans-serif-condensed"/>
                        <TextView
                            android:textSize="@dimen/spinner_txt_size"
                            android:textStyle="bold"
                            android:textColor="@color/seventytransparentblack"
                            android:id="@+id/tv_advanceamount_bottomsheet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="end"
                        android:layout_gravity="end"
                        android:orientation="horizontal"
                        android:id="@+id/layoutRemainingAmount"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/spinner_txt_size"
                            android:textStyle="bold"
                            android:textColor="@color/seventytransparentblack"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Remaining Amount :"
                            android:fontFamily="sans-serif-condensed"/>
                        <TextView
                            android:textSize="@dimen/spinner_txt_size"
                            android:textStyle="bold"
                            android:textColor="@color/seventytransparentblack"
                            android:id="@+id/tv_remainingamount_bottomsheet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed"/>
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
