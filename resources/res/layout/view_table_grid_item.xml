<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:id="@+id/card_view_table"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="5dp">
    <RelativeLayout
        android:gravity="center"
        android:background="@drawable/bg_table_item"
        android:paddingTop="@dimen/view_table_grid_padding_margin"
        android:paddingBottom="5dp"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true">
            <android.support.v7.widget.AppCompatCheckBox
                android:id="@+id/check_box_table"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:buttonTint="@color/orange"/>
            <TextView
                android:textSize="@dimen/text_time_text"
                android:textColor="@color/indicator_red"
                android:id="@+id/tv_tabletime"
                android:paddingLeft="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:text="10:00"
                android:singleLine="true"
                android:fontFamily="sans-serif-condensed"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/text_time_text"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_tableoccupy"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="11:00"
            android:singleLine="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:fontFamily="sans-serif-condensed"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:id="@+id/image_table"
            android:layout_width="@dimen/activity_main_spinner_width"
            android:layout_height="@dimen/activity_main_spinner_width"
            android:layout_marginTop="@dimen/bg_logout_button"
            android:src="@drawable/ic_table_available"
            android:layout_alignParentTop="true"
            android:layout_centerInParent="true"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
        <View
            android:id="@+id/view_table_horizontalview"
            android:background="@color/lightgrey"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="-5dp"
            android:layout_below="@+id/image_table"/>
        <TextView
            android:textSize="@dimen/table_name_text"
            android:textColor="@color/orange"
            android:gravity="center"
            android:id="@+id/text_table"
            android:background="@android:color/transparent"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="table name"
            android:layout_below="@+id/view_table_horizontalview"
            android:layout_centerHorizontal="true"
            android:fontFamily="sans-serif-condensed"/>
    </RelativeLayout>
</android.support.v7.widget.CardView>
