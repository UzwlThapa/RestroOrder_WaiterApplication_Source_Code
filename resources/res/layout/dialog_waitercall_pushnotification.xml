<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:padding="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/indicator_red"
        android:id="@+id/tv_push_dialog_error"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="hello eorror"
        android:layout_alignParentTop="true"/>
    <ImageView
        android:id="@+id/iv_dialog_logo"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:src="@drawable/ok"
        android:layout_below="@+id/tv_push_dialog_error"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="25sp"
        android:textColor="@color/white"
        android:id="@+id/tv_dialog_callwaiter_department"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="Please report in to kitchen"
        android:layout_below="@+id/iv_dialog_logo"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="25sp"
        android:textColor="@color/white"
        android:id="@+id/tv_dialog_callwaiter_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="Please report in to kitchen"
        android:layout_below="@+id/tv_dialog_callwaiter_department"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="25sp"
        android:textColor="@color/white"
        android:id="@+id/tv_dialog_callwaiter_tableno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="Please report in to kitchen"
        android:layout_below="@+id/tv_dialog_callwaiter_item"
        android:layout_centerHorizontal="true"/>
    <View
        android:id="@+id/view_pushnotification"
        android:background="@color/orange"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/tv_dialog_callwaiter_tableno"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_forwarding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/view_pushnotification">
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/orange"
            android:id="@+id/tv_push_dialog_message"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send To Other Waiter:"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_dialog_callwaiter_forward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true">
            <Spinner
                android:id="@+id/sp_dialog_callwaiter_waiterlists"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"/>
            <Button
                android:textSize="20sp"
                android:textColor="@color/white"
                android:id="@+id/btn_dialog_callwaiter_forward"
                android:background="@drawable/bg_edittext"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:layout_marginLeft="5dp"
                android:text="Send"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/refresh_waiters"
            android:background="@drawable/ic_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"/>
        <ProgressBar
            android:id="@+id/pb_pushnotification"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"/>
    </LinearLayout>
    <Button
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/btn_dialog_callwaiter_dismiss"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ok"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
