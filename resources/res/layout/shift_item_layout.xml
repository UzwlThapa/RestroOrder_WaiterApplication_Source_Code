<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/show_bill_header"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="2dp">
            <TextView
                android:textSize="@dimen/spinner_txt_size"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/shifItem_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:layout_marginLeft="10dp"
                android:text="Move Item To Table "
                android:layout_alignParentLeft="true"
                android:fontFamily="sans-serif-condensed"/>
        </RelativeLayout>
        <View
            android:background="@color/black"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="0dp"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/spinner_txt_size"
                android:textColor="@color/black"
                android:id="@+id/tv_billNoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text="Bill No:"
                android:fontFamily="sans-serif-condensed"/>
            <TextView
                android:textSize="@dimen/spinner_txt_size"
                android:textColor="@color/black"
                android:id="@+id/tv_shiftItemTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text="Title"
                android:layout_toRightOf="@+id/tv_billNoTitle"
                android:fontFamily="sans-serif-condensed"/>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/spinner_txt_size"
                android:textColor="@color/black"
                android:id="@+id/tv_shift_qty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text="Qty : "
                android:fontFamily="sans-serif-condensed"/>
            <Spinner
                android:id="@+id/sp_shift_seat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_toRightOf="@+id/tv_shift_qty"
                style="@android:style/Widget.Holo.Light.Spinner"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ShiftLayout"
        android:background="@color/orange"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:layout_marginTop="10dp">
        <TextView
            android:textSize="@dimen/spinner_txt_size"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tvShift"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="Shift Item"/>
    </LinearLayout>
</LinearLayout>
