<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clickable="true"
    android:longClickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="@color/bg_view_color"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/rv_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/spinner_txt_size"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/tv_adapter_showbill_sn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="S.N."
                android:layout_weight="1"
                android:fontFamily="sans-serif-condensed"/>
            <TextView
                android:textSize="@dimen/spinner_txt_size"
                android:textColor="@color/black"
                android:id="@+id/tv_adapter_showbill_items"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Items"
                android:layout_weight="5"
                android:layout_toRightOf="@+id/tv_adapter_showbill_sn"
                android:fontFamily="sans-serif-condensed"/>
            <TextView
                android:textSize="@dimen/spinner_txt_size"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/tv_adapter_showbill_quantity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Quantity"
                android:layout_weight="2"
                android:fontFamily="sans-serif-condensed"/>
            <ImageView
                android:id="@+id/bt_plus_shift"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_add"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/layoutExtraItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50dp">
            <android.support.v7.widget.RecyclerView
                android:id="@+id/tv_extra_itemlist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/layoutNoData"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="25sp"
                android:textColor="@color/orange"
                android:gravity="center"
                android:id="@+id/noDatasAvailable"
                android:background="@color/white"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="No Data Available"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/menu_table_small_text"
        android:textColor="@color/black"
        android:id="@+id/tv_Extra_Item"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:text="Extra Items"/>
</RelativeLayout>
