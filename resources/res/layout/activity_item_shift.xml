<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/orange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/show_bill_header"
                android:background="@color/orange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/spinner_txt_size"
                    android:textColor="@color/white"
                    android:id="@+id/shifItem_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:text="Shift Order "
                    android:fontFamily="sans-serif-condensed"/>
                <TextView
                    android:textSize="@dimen/spinner_txt_size"
                    android:textColor="@color/white"
                    android:id="@+id/tv_showbill_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:layout_marginLeft="10dp"
                    android:text="Bill No: "
                    android:layout_toRightOf="@+id/shifItem_title"
                    android:fontFamily="sans-serif-condensed"/>
                <Spinner
                    android:id="@+id/sp_shift_seat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/tv_showbill_name"
                    style="@android:style/Widget.Holo.Light.Spinner"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="horizontal"
                android:background="@color/orange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/spinner_txt_size"
                    android:textColor="@color/white"
                    android:id="@+id/tv_tabledate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:layout_marginLeft="10dp"
                    android:text="Date: "
                    android:fontFamily="sans-serif-condensed"/>
                <TextView
                    android:textSize="@dimen/spinner_txt_size"
                    android:textColor="@color/white"
                    android:id="@+id/tv_shift_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:text="Date "
                    android:layout_toRightOf="@+id/tv_tabledate"
                    android:fontFamily="sans-serif-condensed"/>
                <TextView
                    android:textSize="@dimen/spinner_txt_size"
                    android:textColor="@color/white"
                    android:id="@+id/tv_waiter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:layout_marginLeft="20dp"
                    android:text="Waiter: "
                    android:layout_toRightOf="@+id/tv_shift_date"
                    android:fontFamily="sans-serif-condensed"/>
                <TextView
                    android:textSize="@dimen/spinner_txt_size"
                    android:textColor="@color/white"
                    android:id="@+id/tv_shift_waitername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:text="Waiter name"
                    android:layout_toRightOf="@+id/tv_waiter"
                    android:fontFamily="sans-serif-condensed"/>
            </RelativeLayout>
        </LinearLayout>
        <View
            android:background="@color/black"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="0dp"/>
        <LinearLayout
            android:id="@+id/layoutData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="3">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3">
                <RelativeLayout
                    android:orientation="horizontal"
                    android:background="@color/orange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/spinner_txt_size"
                        android:textColor="@color/white"
                        android:id="@+id/tv_showbill_table"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:layout_marginLeft="10dp"
                        android:text="FROM:"
                        android:fontFamily="sans-serif-condensed"/>
                    <TextView
                        android:textSize="@dimen/spinner_txt_size"
                        android:textColor="@color/white"
                        android:id="@+id/tv_shift_tablename"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:text="From Title "
                        android:layout_toRightOf="@+id/tv_showbill_table"
                        android:fontFamily="sans-serif-condensed"/>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/show_bill_title"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/menu_table_small_text"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/tv_showbill_sn"
                        android:paddingTop="@dimen/activity_main_layout_selected_title_padding"
                        android:paddingBottom="@dimen/activity_main_layout_selected_title_padding"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="S.N."
                        android:layout_weight="0.25"
                        android:fontFamily="sans-serif-condensed"/>
                    <TextView
                        android:textSize="@dimen/menu_table_small_text"
                        android:textColor="@color/black"
                        android:layout_gravity="center"
                        android:id="@+id/tv_showbill_items"
                        android:paddingTop="@dimen/activity_main_layout_selected_title_padding"
                        android:paddingRight="12dp"
                        android:paddingBottom="@dimen/activity_main_layout_selected_title_padding"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Items"
                        android:layout_weight="2"
                        android:fontFamily="sans-serif-condensed"/>
                    <TextView
                        android:textSize="@dimen/menu_table_small_text"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/tv_showbill_quantity"
                        android:paddingTop="@dimen/activity_main_layout_selected_title_padding"
                        android:paddingBottom="@dimen/activity_main_layout_selected_title_padding"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quantity"
                        android:layout_weight="0.35"
                        android:fontFamily="sans-serif-condensed"/>
                </LinearLayout>
                <View
                    android:background="@drawable/table_gradient"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="0dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/item_shift_rv_layout">
                    <TextView
                        android:textSize="25sp"
                        android:textColor="@color/orange"
                        android:gravity="center"
                        android:id="@+id/noData"
                        android:background="@color/white"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="No Data Available"/>
                    <ScrollView
                        android:id="@+id/scrollview"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <android.support.v7.widget.RecyclerView
                            android:id="@+id/rv_shiftItem1"
                            android:background="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </ScrollView>
                </LinearLayout>
            </LinearLayout>
            <View
                android:background="@drawable/table_gradient"
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:layout_marginTop="0dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.7">
                <RelativeLayout
                    android:orientation="horizontal"
                    android:background="@color/orange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/spinner_txt_size"
                        android:textColor="@color/white"
                        android:id="@+id/tv_to"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:text="TO:"
                        android:fontFamily="sans-serif-condensed"/>
                    <Spinner
                        android:ellipsize="marquee"
                        android:id="@+id/sp_shift_tabletitle"
                        android:layout_width="125dp"
                        android:layout_height="wrap_content"
                        android:scrollHorizontally="true"
                        android:layout_toRightOf="@+id/tv_to"
                        android:marqueeRepeatLimit="marquee_forever"
                        style="@android:style/Widget.Holo.Light.Spinner"/>
                    <Spinner
                        android:ellipsize="marquee"
                        android:id="@+id/sp_shift_tableno"
                        android:layout_width="105dp"
                        android:layout_height="wrap_content"
                        android:scrollHorizontally="true"
                        android:layout_toRightOf="@+id/sp_shift_tabletitle"
                        android:layout_alignParentTop="true"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:layout_toEndOf="@+id/sp_shift_tabletitle"
                        style="@android:style/Widget.Holo.Light.Spinner"/>
                    <Spinner
                        android:ellipsize="marquee"
                        android:id="@+id/sp_shift_tableumber"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:scrollHorizontally="true"
                        android:layout_toRightOf="@+id/sp_shift_tableno"
                        android:marqueeRepeatLimit="marquee_forever"
                        style="@android:style/Widget.Holo.Light.Spinner"/>
                    <TextView
                        android:textSize="@dimen/spinner_txt_size"
                        android:textColor="@color/white"
                        android:id="@+id/tv_shift_Split"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:text="SplitNo: "
                        android:layout_toRightOf="@+id/sp_shift_tableumber"
                        android:fontFamily="sans-serif-condensed"/>
                    <Spinner
                        android:ellipsize="marquee"
                        android:id="@+id/sp_shift_SplitNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scrollHorizontally="true"
                        android:layout_toRightOf="@+id/tv_shift_Split"
                        android:marqueeRepeatLimit="marquee_forever"
                        style="@android:style/Widget.Holo.Light.Spinner"/>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/shift_item_to"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/menu_table_small_text"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/tv_shiftItem_sn"
                        android:paddingTop="@dimen/activity_main_layout_selected_title_padding"
                        android:paddingBottom="@dimen/activity_main_layout_selected_title_padding"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="S.N."
                        android:layout_weight="0.25"
                        android:fontFamily="sans-serif-condensed"/>
                    <TextView
                        android:textSize="@dimen/menu_table_small_text"
                        android:textColor="@color/black"
                        android:layout_gravity="center"
                        android:id="@+id/tv_shiftItem_items"
                        android:paddingTop="@dimen/activity_main_layout_selected_title_padding"
                        android:paddingRight="12dp"
                        android:paddingBottom="@dimen/activity_main_layout_selected_title_padding"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Items"
                        android:layout_weight="2"
                        android:fontFamily="sans-serif-condensed"/>
                    <TextView
                        android:textSize="@dimen/menu_table_small_text"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/tv_shiftItem_quantity"
                        android:paddingTop="@dimen/activity_main_layout_selected_title_padding"
                        android:paddingBottom="@dimen/activity_main_layout_selected_title_padding"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quantity"
                        android:layout_weight="0.35"
                        android:fontFamily="sans-serif-condensed"/>
                </LinearLayout>
                <View
                    android:background="@drawable/table_gradient"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="0dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/item_shift_rv_layout">
                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <android.support.v7.widget.RecyclerView
                            android:id="@+id/rv_shiftItem2"
                            android:background="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </ScrollView>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="25sp"
            android:textColor="@color/orange"
            android:gravity="center"
            android:id="@+id/noDataAvailable"
            android:background="@color/white"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="No Data Available"/>
        <View
            android:background="@drawable/table_gradient"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="0dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <Button
                android:textSize="@dimen/activity_main_bt_send_textSize"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/bt_shift_cancel"
                android:background="@drawable/button_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="10dp"
                android:text="Cancel"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-condensed"/>
            <Button
                android:textSize="@dimen/activity_main_bt_send_textSize"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/bt_ShiftItem"
                android:background="@drawable/button_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shift Item"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-condensed"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
