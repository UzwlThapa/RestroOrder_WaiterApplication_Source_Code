<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_view_menu"
    android:layout_width="@dimen/menu_width"
    android:layout_height="@dimen/menu_width"
    android:layout_marginRight="5dp"
    card_view:cardBackgroundColor="@android:color/transparent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/iv_item_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/img_menu1"
            android:scaleType="fitXY"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:background="@color/fortytransparentblack"
            android:padding="2dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/menu_shadow_height"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="@dimen/textSize"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="left"
                android:id="@+id/childname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="Menu Name "
                android:maxLines="2"
                android:scrollHorizontally="true"
                android:fontFamily="sans-serif-condensed"/>
            <TextView
                android:textSize="@dimen/menu_subtext"
                android:textColor="@color/white"
                android:gravity="left"
                android:id="@+id/tv_child3row_rate"
                android:paddingBottom="3dp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="Subtitles"
                android:fontFamily="sans-serif-condensed"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/activity_login_et_up_textSize"
            android:textStyle="bold"
            android:textColor="#fffdb1b1"
            android:gravity="center"
            android:id="@+id/tv_infoStock"
            android:background="@color/fiftytransparentblack"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Out of Stock"
            android:singleLine="true"
            android:layout_centerHorizontal="true"
            android:fontFamily="sans-serif-condensed"/>
    </RelativeLayout>
</android.support.v7.widget.CardView>
