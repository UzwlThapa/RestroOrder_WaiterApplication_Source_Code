<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorlayout_mainactivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:gravity="center"
            android:id="@+id/layout_header"
            android:background="@color/orange"
            android:paddingTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_alignParentLeft="true"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true">
                <ImageView
                    android:id="@+id/image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_itemmenu"/>
                <TextView
                    android:textSize="@dimen/toolbar_headertxt"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/txt_menu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Menu"
                    android:layout_alignRight="@+id/image"
                    android:fontFamily="sans-serif-condensed"/>
            </LinearLayout>
            <RelativeLayout
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/layout_logout"
                android:layout_centerVertical="true"/>
            <LinearLayout
                android:gravity="right"
                android:layout_gravity="right"
                android:orientation="horizontal"
                android:id="@+id/layout_logout"
                android:background="@color/quantity_back"
                android:paddingRight="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="@dimen/margin_waiter"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@+id/iv_user"
                    android:paddingLeft="10dp"
                    android:paddingTop="5dp"
                    android:paddingRight="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/user"/>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:background="@android:color/transparent"
                    android:padding="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/toolbar_waitername"
                        android:textColor="@color/white"
                        android:layout_gravity="left"
                        android:id="@+id/tv_waiter_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Waiter Name"
                        android:editable="false"
                        android:fontFamily="sans-serif-condensed"/>
                    <TextView
                        android:textSize="@dimen/toolbar_role"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:layout_gravity="left"
                        android:id="@+id/tv_waiter"
                        android:paddingBottom="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Waiter"
                        android:layout_below="@+id/tv_waiter_name"
                        android:fontFamily="sans-serif-condensed"/>
                </LinearLayout>
                <ImageButton
                    android:textColor="@android:color/black"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/txt_logout"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/exit_logo"
                    android:text="Logout"
                    android:layout_toRightOf="@+id/tv_waiter"
                    android:layout_centerInParent="true"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="right"
                android:orientation="horizontal"
                android:id="@+id/layout_call_waiter"
                android:paddingTop="5dp"
                android:paddingRight="5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginRight="25dp"
                android:layout_marginBottom="10dp"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true">
                <LinearLayout
                    android:id="@+id/layout_call_waiter1"
                    android:background="@color/quantity_back"
                    android:padding="5dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/iv_waiter"
                        android:paddingRight="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/user"/>
                    <Button
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:layout_gravity="right"
                        android:id="@+id/bt_call_waiter"
                        android:background="@android:color/transparent"
                        android:padding="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Call Waiter"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/iv_set_table"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:src="@drawable/ic_settings_white_36dp"/>
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="2">
            <FrameLayout
                android:name="com.danfe.restaurantapp.MenuItemFragment"
                android:id="@+id/layout_menu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.6"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_menuitems"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_weight="0.4">
                <RelativeLayout
                    android:layout_gravity="left"
                    android:orientation="horizontal"
                    android:id="@+id/layout_order"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/layoutTableInfo"
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_centerInParent="true">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:padding="3dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:layout_centerInParent="true">
                            <TextView
                                android:textSize="@dimen/menu_menu"
                                android:textColor="@color/black"
                                android:gravity="center"
                                android:id="@+id/tvOrderListTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Orderlist |"
                                android:fontFamily="sans-serif-condensed"/>
                            <LinearLayout
                                android:layout_gravity="center_horizontal"
                                android:orientation="horizontal"
                                android:id="@+id/layout_split"
                                android:paddingLeft="5dp"
                                android:visibility="visible"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true">
                                <CheckBox
                                    android:textSize="@dimen/spinner_txt_size"
                                    android:textColor="@color/black"
                                    android:id="@+id/cb_split"
                                    android:paddingLeft="3dp"
                                    android:paddingRight="3dp"
                                    android:visibility="visible"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Split bill"
                                    android:layout_alignParentLeft="true"
                                    android:layout_centerInParent="true"
                                    android:fontFamily="sans-serif-condensed"/>
                                <ImageButton
                                    android:id="@+id/bt_refresh"
                                    android:background="@drawable/bg_room"
                                    android:visibility="gone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/ic_refresh"
                                    android:layout_alignParentRight="true"
                                    android:layout_centerInParent="true"/>
                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:id="@+id/layout_bill"
                                    android:paddingLeft="5dp"
                                    android:paddingRight="5dp"
                                    android:visibility="gone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_toLeftOf="@+id/cb_split">
                                    <TextView
                                        android:textSize="@dimen/spinner_txt_size"
                                        android:textColor="@color/black"
                                        android:layout_gravity="center"
                                        android:id="@+id/text_view_bill"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="| Bill No"/>
                                    <Spinner
                                        android:id="@+id/sp_seat"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        style="@android:style/Widget.Holo.Light.Spinner"/>
                                    <ImageButton
                                        android:textColor="@color/white"
                                        android:id="@+id/bt_enter_guest"
                                        android:background="@drawable/ic_add"
                                        android:padding="5dp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-condensed"/>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="left"
                            android:layout_gravity="left"
                            android:orientation="horizontal"
                            android:id="@+id/layout_table"
                            android:paddingRight="@dimen/activity_main_layout_table_padding_right"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="@dimen/menu_table_small_text"
                                android:textColor="@color/black"
                                android:id="@+id/tv_table_no"
                                android:paddingRight="5dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Table-09"
                                android:fontFamily="sans-serif-condensed"/>
                            <TextView
                                android:textSize="@dimen/menu_table_small_text"
                                android:textColor="@color/black"
                                android:id="@+id/tv_room_no"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Room A"
                                android:fontFamily="sans-serif-condensed"/>
                        </LinearLayout>
                    </LinearLayout>
                </RelativeLayout>
                <LinearLayout
                    android:id="@+id/orderedOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/menu_table_small_text"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:id="@+id/et_ordered"
                        android:background="@drawable/bg_menu_title_start"
                        android:padding="@dimen/activity_main_bt_send_marginRight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:text="Ordered"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="@dimen/menu_table_small_text"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:id="@+id/et_inProgress"
                        android:background="@drawable/bg_menu_title_start"
                        android:padding="@dimen/activity_main_bt_send_marginRight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:text="In Progress"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="@dimen/menu_table_small_text"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:id="@+id/et_completed"
                        android:background="@drawable/bg_menu_title_start"
                        android:padding="@dimen/activity_main_bt_send_marginRight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:text="Completed"
                        android:layout_weight="1"/>
                </LinearLayout>
                <View
                    android:background="@color/bg_menu_title_start_color"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layout_order_list"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:id="@+id/layout_selected_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/menu_table_small_text"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/tv_sn_header"
                            android:paddingTop="@dimen/activity_main_layout_selected_title_padding"
                            android:paddingBottom="@dimen/activity_main_layout_selected_title_padding"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="S.N."
                            android:layout_weight="0.18"
                            android:fontFamily="sans-serif-condensed"/>
                        <TextView
                            android:textSize="@dimen/menu_table_small_text"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/tv_name_header"
                            android:paddingTop="@dimen/activity_main_layout_selected_title_padding"
                            android:paddingRight="12dp"
                            android:paddingBottom="@dimen/activity_main_layout_selected_title_padding"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Items"
                            android:layout_weight="0.47"
                            android:fontFamily="sans-serif-condensed"/>
                        <TextView
                            android:textSize="@dimen/menu_table_small_text"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/tv_quantity_header"
                            android:paddingTop="@dimen/activity_main_layout_selected_title_padding"
                            android:paddingBottom="@dimen/activity_main_layout_selected_title_padding"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Quantity"
                            android:layout_weight="0.35"
                            android:fontFamily="sans-serif-condensed"/>
                        <TextView
                            android:textSize="@dimen/menu_table_small_text"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/tv_extra_header"
                            android:paddingTop="@dimen/activity_main_layout_selected_title_padding"
                            android:paddingBottom="@dimen/activity_main_layout_selected_title_padding"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Extra"
                            android:layout_weight="0.25"
                            android:fontFamily="sans-serif-condensed"/>
                    </LinearLayout>
                    <View
                        android:background="@color/bg_view_color"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"/>
                    <ListView
                        android:id="@+id/list_order"
                        android:longClickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/listview_menu_height"
                        android:transcriptMode="normal"/>
                    <View
                        android:background="@color/bg_view_color"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="5dp"/>
                    <LinearLayout
                        android:gravity="bottom|right"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:weightSum="4"
                        android:layout_below="@+id/layout_split">
                        <Button
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/bt_cancel"
                            android:background="@drawable/button_bg"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/activity_main_button"
                            android:layout_marginRight="10dp"
                            android:text="Back"
                            android:layout_weight="1"
                            android:textAllCaps="false"
                            android:fontFamily="sans-serif-condensed"/>
                        <Button
                            android:textSize="@dimen/activity_main_bt_send_textSize"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/bt_send"
                            android:background="@drawable/button_bg"
                            android:paddingRight="5dp"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/activity_main_button"
                            android:text="Send Order"
                            android:layout_weight="1.3"
                            android:textAllCaps="false"
                            android:fontFamily="sans-serif-condensed"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="right"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="25dp"
        android:layout_alignParentRight="true"
        app:layout_anchor="@+id/bottomsheets_totalamount"
        app:layout_anchorGravity="right">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_copyright"/>
        <TextView
            android:textColor="@color/black"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Powered By"/>
    </LinearLayout>
    <include
        android:id="@+id/bottomsheets_totalamount"
        layout="@layout/layout_bottom_sheets_totalamt"/>
</android.support.design.widget.CoordinatorLayout>
