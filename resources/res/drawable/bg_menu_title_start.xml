<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:insetBottom="-4dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/white"/>
        <stroke
            android:width="@dimen/stroke"
            android:color="@color/lightgrey"/>
        <padding
            android:left="@dimen/bottompadding"
            android:top="@dimen/bottompadding"
            android:right="@dimen/bottompadding"
            android:bottom="8dp"/>
        <corners
            android:topLeftRadius="@dimen/topleftradius"
            android:topRightRadius="@dimen/topleftradius"/>
    </shape>
</inset>
